      <div class='section'>
        <hr/>
        <div class='row itemRow align-items-start'>
            <div class='col-xs-12 col-xl-6 col-xs-offset-3 col-xl-offset-0 buybox'>
              <div class='row'>
                <div class='col-12'>
                  <p>Splitter will shortly be released as a Unity Asset, available for purchase in the Unity Asset Store.</p>
                </div>
              </div>
              <div class='row'>
                <div class='col-12'>
                  <button type="button" class="btn btn-primary btn-lg">View in the Unity Asset Store</button>
